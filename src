#!/usr/bin/env python3
"""Goal: Calibrate an HX711 scale, compare two objects, and log the result."""

import csv
import math
from datetime import datetime
from pathlib import Path

DOUT_GPIO = 5  # BCM GPIO5, physical pin 29
SCK_GPIO = 6   # BCM GPIO6, physical pin 31
SAMPLES = 15
CSV_FILE = Path(__file__).with_name("weight_comparisons.csv")


def read_raw(hx, label):
    for attempt in range(1, 6):
        value = hx.get_raw_data_mean(SAMPLES)
        if value is not False and isinstance(value, (int, float)) and math.isfinite(value):
            return float(value)
        print(f"Could not read {label} (attempt {attempt}/5). Retrying...")
    raise RuntimeError(f"No valid HX711 reading for {label}. Check power, wiring, and the load cell.")


def known_mass():
    while True:
        try:
            grams = float(input("Mass of your calibration object in grams: ").strip())
        except ValueError:
            print("Enter a number, for example 200 or 200.5.")
            continue
        if math.isfinite(grams) and grams > 0:
            return grams
        print("Use a positive, finite weight in grams.")


def grams_from_raw(raw, offset, counts_per_gram):
    return (raw - offset) / counts_per_gram


def save_result(row, path=None):
    if path is None:
        path = CSV_FILE
    columns = [
        "timestamp", "calibration_mass_g", "calibration_empty_raw",
        "calibration_loaded_raw", "counts_per_gram", "measurement_empty_raw",
        "object_1_raw", "object_1_g", "object_2_raw", "object_2_g",
        "difference_2_minus_1_g", "absolute_difference_g",
    ]
    needs_header = not path.exists() or path.stat().st_size == 0
    with path.open("a", newline="", encoding="utf-8") as file:
        writer = csv.DictWriter(file, fieldnames=columns)
        if needs_header:
            writer.writeheader()
        writer.writerow(row)


def run(hx):
    print("Keep the scale still during each reading.")
    input("Remove everything from the scale, then press Enter to tare: ")
    empty_raw = read_raw(hx, "empty scale")
    print(f"Empty reading: {empty_raw:.0f} counts")

    calibration_mass = known_mass()
    input(f"Put the {calibration_mass:g} g reference on the scale, then press Enter: ")
    loaded_raw = read_raw(hx, "calibration weight")
    counts_per_gram = (loaded_raw - empty_raw) / calibration_mass
    if abs(loaded_raw - empty_raw) < 1:
        raise RuntimeError("The reference weight did not change the reading. Check the load cell and try again.")
    print(f"Calibration factor: {counts_per_gram:.3f} counts/g")

    input("Remove the reference and leave the scale empty. Press Enter to check zero: ")
    measurement_empty_raw = read_raw(hx, "empty scale before measurement")
    zero_shift_g = grams_from_raw(measurement_empty_raw, empty_raw, counts_per_gram)
    print(f"Zero drift since calibration: {zero_shift_g:+.2f} g (tared for this comparison)")

    input("Put ONLY object 1 on the scale, then press Enter: ")
    object_1_raw = read_raw(hx, "object 1")
    weight_1_g = grams_from_raw(object_1_raw, measurement_empty_raw, counts_per_gram)
    print(f"Object 1: {weight_1_g:.2f} g")

    input("Remove object 1, put ONLY object 2 on the scale, then press Enter: ")
    object_2_raw = read_raw(hx, "object 2")
    weight_2_g = grams_from_raw(object_2_raw, measurement_empty_raw, counts_per_gram)
    difference_g = weight_2_g - weight_1_g
    print(f"Object 2: {weight_2_g:.2f} g")
    print(f"Object 2 minus object 1: {difference_g:+.2f} g")
    print(f"Absolute difference: {abs(difference_g):.2f} g")

    row = {
        "timestamp": datetime.now().astimezone().isoformat(timespec="seconds"),
        "calibration_mass_g": round(calibration_mass, 3),
        "calibration_empty_raw": round(empty_raw),
        "calibration_loaded_raw": round(loaded_raw),
        "counts_per_gram": round(counts_per_gram, 6),
        "measurement_empty_raw": round(measurement_empty_raw),
        "object_1_raw": round(object_1_raw),
        "object_1_g": round(weight_1_g, 3),
        "object_2_raw": round(object_2_raw),
        "object_2_g": round(weight_2_g, 3),
        "difference_2_minus_1_g": round(difference_g, 3),
        "absolute_difference_g": round(abs(difference_g), 3),
    }
    save_result(row)
    print(f"Saved comparison to {CSV_FILE}")
    return row


def main():
    import RPi.GPIO as GPIO
    from hx711 import HX711

    GPIO.setmode(GPIO.BCM)
    try:
        hx = HX711(dout_pin=DOUT_GPIO, pd_sck_pin=SCK_GPIO)
        run(hx)
    finally:
        GPIO.cleanup()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nStopped. No incomplete comparison was saved.")
    except (RuntimeError, OSError) as exc:
        print(f"Error: {exc}")
        raise SystemExit(1) from exc
